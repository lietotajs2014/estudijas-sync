# Nokopē uz .env un aizpildi. .env NEKAD neliec git (tas ir .gitignore).

# Publiskā adrese (bez slīpsvītras beigās)
BASE_URL=https://estudijas.lodelo.de

# Ģenerē: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Ģenerē: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SVARĪGI: ja šo pazaudē, visi saglabātie žetoni kļūst nelietojami (lietotājiem jāpieslēdzas no jauna).
ENCRYPTION_KEY=
# Ģenerē: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Google Cloud → APIs & Services → Credentials → OAuth client ID → "Web application"
#   Authorized redirect URI: https://estudijas.lodelo.de/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kas drīkst pieteikties (Google e-pasti, atdalīti ar komatu). Tukšs = neviens.
ALLOWED_EMAILS=lietotajs2014@gmail.com
ADMIN_EMAILS=lietotajs2014@gmail.com

# Tikai tunnel variantam: Cloudflare Zero Trust → Networks → Tunnels → token
CLOUDFLARE_TUNNEL_TOKEN=

# Debug pieteikšanās — TIKAI dev versijā (dev.lodelo.de vai localhost), tikai ADMIN_EMAILS.
# Nekas netiek ievadīts automātiski: lokāli atveras īsts pārlūka logs (der Windows passkey),
# serverī lapā redzams servera pārlūka ekrāns, uz kura klikšķini un raksti.
# LOGIN_DEBUG=1
# LOGIN_BROWSER_CHANNEL=msedge     # tikai lokāli: msedge / chrome
# Dev serverī: īsts pārlūka logs, redzams pārlūkā caur noVNC (dev image). Cloudflare lodelo-dev tunelim
# pievieno otru Published application: devlive.lodelo.de → HTTP web:6080
# LOGIN_LIVE=1
# VNC_PASSWORD=                    # obligāti, līdz 8 simboliem (noVNC to prasīs)
# LOGIN_LIVE_URL=https://devlive.lodelo.de/vnc.html?autoconnect=1&resize=scale

# Dev versijai blakus oficiālajai (sk. DEPLOY.md): atsevišķi konteineri un DB
# COMPOSE_PROJECT_NAME=lodelo-dev

# Neobligāti
# SCHEDULE_TIMES=07:30,19:30
# MOODLE_SITE=https://estudijas.rtu.lv
# IMAGE=ghcr.io/lietotajs2014/estudijas-sync:dev
